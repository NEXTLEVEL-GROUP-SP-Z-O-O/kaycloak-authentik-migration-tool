{
  "id": "kc2ak-test",
  "realm": "kc2ak-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "duplicateEmailsAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Plain realm role, migrates cleanly to a group",
        "composite": false
      },
      {
        "name": "code-reviewer",
        "description": "Plain realm role, constituent of the composite below",
        "composite": false
      },
      {
        "name": "senior-engineer",
        "description": "Composite realm role -- must CONFLICT / composite_role_unsupported",
        "composite": true,
        "composites": {
          "realm": [
            "employee",
            "code-reviewer"
          ]
        }
      },
      {
        "name": "engineering",
        "description": "Realm role whose name collides with the 'engineering' group -- must CONFLICT / role_name_taken_by_group",
        "composite": false
      }
    ],
    "client": {
      "confidential-app": [
        {
          "name": "admin",
          "description": "Client role, same name as internal-tool's 'admin' -- reported unmapped, never migrated"
        }
      ],
      "internal-tool": [
        {
          "name": "admin",
          "description": "Client role, same name as confidential-app's 'admin' -- reported unmapped, never migrated"
        }
      ]
    }
  },
  "identityProviders": [
    {
      "alias": "corporate-sso",
      "providerId": "oidc",
      "enabled": true,
      "config": {
        "clientId": "kc2ak-test-oidc-client",
        "clientSecret": "kc2ak-test-idp-secret",
        "authorizationUrl": "http://localhost:8081/realms/kc2ak-test/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak:8080/realms/kc2ak-test/protocol/openid-connect/token",
        "userInfoUrl": "http://keycloak:8080/realms/kc2ak-test/protocol/openid-connect/userinfo",
        "clientAuthMethod": "client_secret_post",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "corporate-saml",
      "providerId": "saml",
      "enabled": true,
      "config": {
        "singleSignOnServiceUrl": "https://saml.example.com/sso",
        "singleLogoutServiceUrl": "https://saml.example.com/slo",
        "idpEntityId": "https://saml.example.com/entity",
        "signingCertificate": "",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "linkedin-sso",
      "providerId": "linkedin-openid-connect",
      "enabled": true,
      "config": {
        "clientId": "kc2ak-test-linkedin-client",
        "clientSecret": "kc2ak-test-linkedin-secret",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "department-attribute",
      "identityProviderAlias": "corporate-sso",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "department",
        "user.attribute": "department"
      }
    }
  ],
  "groups": [
    {
      "id": "11111111-0000-0000-0000-000000000001",
      "name": "engineering",
      "path": "/engineering",
      "attributes": {},
      "subGroups": []
    },
    {
      "id": "11111111-0000-0000-0000-000000000002",
      "name": "marketing",
      "path": "/marketing",
      "attributes": {},
      "subGroups": []
    },
    {
      "id": "11111111-0000-0000-0000-000000000003",
      "name": "sales",
      "path": "/sales",
      "attributes": {},
      "subGroups": [
        {
          "id": "11111111-0000-0000-0000-000000000004",
          "name": "admins",
          "path": "/sales/admins",
          "attributes": {},
          "subGroups": []
        }
      ]
    }
  ],
  "users": [
    {
      "id": "22222222-0000-0000-0000-000000000001",
