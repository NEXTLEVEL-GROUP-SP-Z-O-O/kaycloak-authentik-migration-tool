# Local test rig (docker-compose.yml). Copy to .env and adjust if you change
# the compose file. These are throwaway test-rig credentials, not secrets.

KC_URL=http://localhost:8081
KC_REALM_ADMIN=admin
KC_ADMIN_PASSWORD=admin
# Alternative to KC_REALM_ADMIN/KC_ADMIN_PASSWORD: a service account client for
# client_credentials auth. Not configured in the local rig; leave unset.
# KC_CLIENT_ID=
# KC_CLIENT_SECRET=

AK_URL=http://localhost:9000
# Value of AUTHENTIK_BOOTSTRAP_TOKEN in docker-compose.yml — see README for how
# this becomes a working admin API token.
AK_TOKEN=kc2ak-local-bootstrap-token
